# Build artifacts — regenerated inside the image
.next
.git
.gitignore

# Local deps + data — never bake these into the image
node_modules
db/*.db
db/*.db-journal
data

# Local dev files
.env
.env.local
*.log
dev-out.log
dev-err.log

# OS / editor noise
.DS_Store
Thumbs.db
.vscode
.idea

# Local-only tooling that shouldn't ship
.local-preview
.zscripts
bun.lock
