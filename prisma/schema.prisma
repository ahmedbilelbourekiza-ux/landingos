// LandingOS — Prisma schema
//
// Provider is SQLite in this sandbox. The schema is provider-portable:
// switching to PostgreSQL is a one-line change — set `provider = "postgresql"`
// and point DATABASE_URL at a Postgres connection string. No @db.* native
// type annotations are used so the same schema compiles on both providers.
//
// Data model scope (Task 2): the landing-page data engine. One LandingPage
// represents one COD product. All child records (media, variants, features,
// reviews, faqs, setting) cascade-delete with their parent. Form submissions
// and CRM webhook delivery belong to later tasks and are intentionally absent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Editorial lifecycle of a landing page. DRAFT while the admin is editing,
// PUBLISHED once it is live, ARCHIVED to take it offline without deleting it.
enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Media is either an image or a video. Kept as an enum because the public
// renderer treats the two types differently (poster frame vs. player).
enum LandingMediaType {
  IMAGE
  VIDEO
}

// Order lifecycle. NEW when the customer submits, then progresses through
// CONFIRMED → PREPARING → SHIPPED → DELIVERED. CANCELLED is a terminal state.
enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

// A landing page represents a single COD product. One page = one product =
// one purchase form. `published` is the public visibility flag; `status` is
// the editorial lifecycle. `webhookUrl` optionally overrides the global
// CRM_WEBHOOK_URL so different products can route to different CRM pipelines.
model LandingPage {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  status         LandingPageStatus @default(DRAFT)
  description    String?
  price          Decimal
  oldPrice       Decimal?
  currency       String            @default("DZD")
  buttonText     String            @default("اطلب الآن")
  ctaButtonText  String?
  announcement   String?
  seoTitle       String?
  seoDescription String?
  facebookPixel  String?
  webhookUrl     String?
  published      Boolean           @default(false)
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  media          LandingMedia[]
  variants       LandingVariant[]
  features       LandingFeature[]
  reviews        LandingReview[]
  faqs           LandingFAQ[]
  setting        LandingSetting?
  orders         Order[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([published])
  @@index([createdAt])
}

// Images and videos attached to a landing page. `displayOrder` controls the
// carousel/gallery sequence. `url` holds either a stored path or a remote URL.
model LandingMedia {
  id            String          @id @default(cuid())
  landingPageId String
  type          LandingMediaType
  url           String
  altText       String?
  displayOrder  Int             @default(0)

  landingPage   LandingPage     @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([landingPageId, displayOrder])
}

// A selectable product option, e.g. name "Size" / value "Large". Flat model:
// each row is one choosable option with an optional extra price. The purchase
// form reads these to build its variant selectors.
model LandingVariant {
  id            String      @id @default(cuid())
  landingPageId String
  name          String
  value         String
  extraPrice    Decimal     @default(0)
  displayOrder  Int         @default(0)

  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([landingPageId, displayOrder])
}

// A product highlight shown in the features grid. `icon` stores an icon key
// (e.g. a lucide name) that the UI maps to a rendered icon component — not a
// file path.
model LandingFeature {
  id            String      @id @default(cuid())
  landingPageId String
  icon          String
  title         String
  description   String?
  displayOrder  Int         @default(0)

  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([landingPageId, displayOrder])
}

// Social-proof testimonial. `rating` is an Int (1–5); the 1–5 range is
// enforced at the API/validation layer since Prisma has no portable CHECK
// constraint. `customerAvatar` is optional — not every review has a photo.
model LandingReview {
  id             String      @id @default(cuid())
  landingPageId  String
  customerName   String
  customerAvatar String?
  rating         Int
  reviewText     String
  displayOrder   Int         @default(0)

  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([landingPageId, displayOrder])
}

// A question/answer pair rendered in the FAQ section.
model LandingFAQ {
  id            String      @id @default(cuid())
  landingPageId String
  question      String
  answer        String
  displayOrder  Int         @default(0)

  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([landingPageId, displayOrder])
}

// 1:1 with LandingPage. Feature flags that control which sections and
// conversion boosters render on the public page. Optional on the page so a
// page renders with sensible defaults until settings are customized.
model LandingSetting {
  id               String      @id @default(cuid())
  landingPageId    String      @unique
  countdownEnabled Boolean      @default(false)
  stickyBuyButton  Boolean      @default(true)
  floatingWhatsapp Boolean      @default(false)
  showReviews      Boolean      @default(true)
  showFAQ          Boolean      @default(true)
  showFeatures     Boolean      @default(true)
  shipping         Decimal      @default(0)
  freeShipping     Boolean      @default(false)
  orderFormConfig  String?

  landingPage      LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// Algerian wilaya. Shared dataset — not per-landing. Every landing reads
// from this single table to populate its delivery price configuration.
// The wilaya code (01–58) is the official Algerian administrative code.
model Wilaya {
  id              Int                     @id
  code            String                  @unique
  name            String
  nameAr          String?
  baladias        Baladia[]
  deliveryPrices  GlobalDeliveryPrice[]

  createdAt       DateTime                @default(now())
}

// Commune within a wilaya. Also shared — not per-landing.
model Baladia {
  id        Int      @id
  name      String
  nameAr    String?
  wilayaId  Int

  wilaya    Wilaya   @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([wilayaId])
}

// Global delivery prices — one row per wilaya, shared by every landing.
// Configured once in the Delivery Prices dashboard page, used by every
// checkout automatically.
model GlobalDeliveryPrice {
  id        String   @id @default(cuid())
  wilayaId  Int      @unique
  homePrice Decimal
  deskPrice Decimal?

  wilaya    Wilaya   @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A customer order. Every field is a snapshot — the order never changes
// even if the landing is edited later. `variants` is a JSON string storing
// the selected options at order time: [{"name":"Color","value":"Black"}].
// Prices are snapshot Decimals, never recalculated.
model Order {
  id            String      @id @default(cuid())
  landingPageId String
  customerName  String
  phone         String
  wilaya        String      // snapshot of wilaya name
  baladia       String      // snapshot of baladia name
  address       String
  notes         String?
  quantity      Int
  variants      String      // JSON snapshot: [{"name":"Color","value":"Black"}]
  productPrice  Decimal     // snapshot — unit price including variant extras
  shippingPrice Decimal     // snapshot — delivery price for the selected wilaya
  totalPrice    Decimal     // snapshot — (productPrice * quantity) + shippingPrice
  status        OrderStatus @default(NEW)

  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  statusHistory OrderStatusHistory[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([landingPageId])
  @@index([status])
  @@index([createdAt])
}

// Timestamped record of every status transition. The initial NEW status is
// recorded as a history entry with fromStatus = null on order creation.
// This gives a complete audit trail: each row shows when the order moved
// from one status to the next.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus   OrderStatus

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())

  @@index([orderId])
}

// Product category. One category has many landing pages. Admin manages
// categories in the dashboard; customers browse them on the homepage and
// category pages.
model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  icon        String?
  coverImage  String?
  sortOrder   Int          @default(0)
  isVisible   Boolean      @default(true)

  landingPages LandingPage[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isVisible])
  @@index([sortOrder])
}
