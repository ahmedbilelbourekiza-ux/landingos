// LandingOS — Prisma schema (foundation)
//
// Database provider is SQLite in this sandbox. The schema is written to be
// provider-portable: switching to PostgreSQL is a one-line change — set
// `provider = "postgresql"` below and point DATABASE_URL at a Postgres
// connection string. Avoid SQLite-specific column types (e.g. use String
// timestamps via @default(now())) to keep that migration frictionless.
//
// No business models yet — they will be added incrementally in later tasks
// (products, landing pages, form submissions, CRM webhook configs, etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
