// =============================================================================
// WEBSITE BUILDER domain.
//
// Ported from apps/website-builder/prisma/schema.prisma. The models are
// unchanged in meaning; what changed is that every one of them now belongs to
// a tenant (M-03) and every unique constraint has a recorded decision (M-04).
//
// The exception is the Algerian reference data — Wilaya and Baladia — which is
// platform-owned and shared by every tenant. It is the only data in this file
// without a tenantId, and it says so where it is defined.
// =============================================================================

enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LandingMediaType {
  IMAGE
  VIDEO
}

// GALLERY is the product slider at the top; media[0] is the hero. DESCRIPTION
// is long-form imagery below the description. One table rather than two,
// because both are ordered image lists owned by a page.
//
// Every query that wants the slider MUST filter on placement. Reading media
// unfiltered now yields description images too, and since media[0] is the hero
// that silently swaps it.
enum LandingMediaPlacement {
  GALLERY
  DESCRIPTION
}

// Algeria's COD market runs on two: delivery to the customer's address, or
// pickup at the carrier's desk, which is cheaper.
enum ShippingMethod {
  HOME
  DESK
}

enum SalesOrderStatus {
  NEW
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

// One landing page = one COD product = one purchase form.
model LandingPage {
  id       String @id @default(cuid())
  tenantId String

  title  String
  // Per decision D2 the public URL is `/<tenant>/<slug>`, so the slug only has
  // to be unique inside a tenant. Left global it would mean the first customer
  // claimed every good slug for everyone who came after.
  slug   String
  status LandingPageStatus @default(DRAFT)

  description    String?
  price          Decimal
  oldPrice       Decimal?
  currency       String  @default("DZD")
  buttonText     String  @default("اطلب الآن")
  ctaButtonText  String?
  announcement   String?
  seoTitle       String?
  seoDescription String?
  // DEAD since the port (M-06/R1): no reader, no writer. Superseded by
  // `trackingIntegrationIds` below, which is what "this page's pixels" means
  // now — plural, and pointing at TrackingIntegration rows rather than
  // holding a bare id this platform has no other use for. Dropped in the
  // coordinated column-drop migration CAPABILITY_AUDIT §2 records.
  facebookPixel  String?
  webhookUrl     String?
  published      Boolean @default(false)

  /* LB.35 — which of the tenant's tracking integrations fire on THIS page.
   *
   * NULL means "all of the tenant's active integrations", which is what every
   * page did before this column existed and therefore what every existing row
   * keeps doing. A non-null array is an explicit subset, so a merchant running
   * two ad accounts can point each product at its own pixel(s) instead of
   * reporting every sale to both.
   *
   * A Json array of ids rather than a join table: the list is small, bounded
   * by the tenant's own integrations, always read whole with the page, and
   * never queried FROM the other side. A join table would add a migration, a
   * relation and an index to answer a question nobody asks. Ids that no longer
   * resolve are ignored at read time, so deleting an integration cannot break
   * a page.
   */
  trackingIntegrationIds Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  themeId    String?
  theme      LandingTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  media       LandingMedia[]
  variants    LandingVariant[]
  features    LandingFeature[]
  reviews     LandingReview[]
  faqs        LandingFAQ[]
  setting     LandingSetting?
  salesOrders SalesOrder[]
  draftOrders DraftOrder[]
  // LB.20 — this product's own delivery prices, where they differ from the
  // company's. Absence means the company's price applies.
  deliveryPrices LandingDeliveryPrice[]
  visits         StorefrontVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, published])
  @@index([tenantId, createdAt])
}

model LandingMedia {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String

  type         LandingMediaType
  url          String
  altText      String?
  // Scoped to the placement, so each list numbers from 0 independently.
  displayOrder Int                   @default(0)
  placement    LandingMediaPlacement @default(GALLERY)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // placement precedes displayOrder because every read filters by it first.
  @@index([tenantId, landingPageId, placement, displayOrder])
}

// A selectable option, e.g. name "Size" / value "Large". Flat by design: each
// row is one choosable option with an optional extra price.
model LandingVariant {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String

  name         String
  value        String
  extraPrice   Decimal @default(0)
  displayOrder Int     @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, landingPageId, displayOrder])
}

// `icon` stores an icon key the UI maps to a component, not a file path.
model LandingFeature {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String

  icon         String
  title        String
  description  String?
  displayOrder Int     @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, landingPageId, displayOrder])
}

// `rating` is 1–5, enforced at the validation layer since Prisma has no
// portable CHECK constraint.
model LandingReview {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String

  customerName   String
  customerAvatar String?
  rating         Int
  reviewText     String
  displayOrder   Int     @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, landingPageId, displayOrder])
}

model LandingFAQ {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String

  question     String
  answer       String
  displayOrder Int    @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, landingPageId, displayOrder])
}

// 1:1 with LandingPage. Feature flags controlling which sections render.
model LandingSetting {
  id       String @id @default(cuid())
  tenantId String
  // @unique rather than @@unique([tenantId, landingPageId]): Prisma requires
  // the referencing field itself to be unique for a one-to-one. It is also
  // correct on its own terms — this references a globally unique cuid, so
  // uniqueness here already means exactly "one setting per page".
  landingPageId String @unique

  countdownEnabled Boolean @default(false)
  stickyBuyButton  Boolean @default(true)
  floatingWhatsapp Boolean @default(false)
  showReviews      Boolean @default(true)
  showFAQ          Boolean @default(true)
  showFeatures     Boolean @default(true)
  /* BH.1 — deep behavior capture is OPT-IN PER PAGE (user-decided), default
   * off. Enforced twice: the collector never arms client-side without it,
   * and the behavior route refuses the update server-side without it — a
   * beacon cannot opt a page in from the outside. */
  behaviorTracking Boolean @default(false)
  shipping         Decimal @default(0)
  freeShipping     Boolean @default(false)
  orderFormConfig  Json?

  // Two booleans rather than a three-value enum: "both" is not a third kind of
  // shipping, it is both of the two, and a carrier added later becomes one more
  // flag instead of an enum with five combinations. The API rejects turning
  // both off — a product with no shipping method cannot be ordered.
  homeDeliveryEnabled Boolean @default(true)
  stopDeskEnabled     Boolean @default(false)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// PLATFORM REFERENCE DATA — deliberately NOT tenant-scoped.
//
// The 58 Algerian wilayas and their communes are facts about the country, not
// content owned by a customer. Every tenant reads the same rows. This is the
// only data in this file without a tenantId, and the constraints test
// allow-lists these two models by name so the omission has to be deliberate.
// -----------------------------------------------------------------------------

model Wilaya {
  id     Int     @id
  code   String  @unique
  name   String
  nameAr String?

  baladias           Baladia[]
  deliveryPrices     TenantDeliveryPrice[]
  // LB.20 — the per-product overrides that name this wilaya.
  pageDeliveryPrices LandingDeliveryPrice[]

  createdAt DateTime @default(now())
}

model Baladia {
  id       Int     @id
  name     String
  nameAr   String?
  wilayaId Int

  wilaya Wilaya @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([wilayaId])
}

// Renamed from GlobalDeliveryPrice. "Global" meant global to the single store
// that used to exist; under multi-tenancy these are one tenant's prices, and
// the old name would actively mislead. One row per wilaya per tenant.
model TenantDeliveryPrice {
  id       String @id @default(cuid())
  tenantId String
  wilayaId Int

  homePrice Decimal
  deskPrice Decimal?

  wilaya Wilaya @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, wilayaId])
  @@index([tenantId])
}

// A delivery price for ONE product, overriding the tenant-wide row above — LB.20.
//
// WHY A SECOND TABLE RATHER THAN A NULLABLE landingPageId ON THE FIRST. The
// existing row is unique on (tenantId, wilayaId) and that uniqueness is what
// makes "the company's price for Alger" a single fact. Adding a nullable page
// column would make the key (tenantId, wilayaId, landingPageId) with NULL
// meaning "the default" — and in Postgres NULLs are not equal to each other, so
// the constraint would stop preventing duplicate defaults. Two tables keep both
// keys total.
//
// A row here means "this product costs THIS much to deliver to that wilaya".
// Absence means "use the company's price", which is what makes the feature
// additive: a tenant who never touches it is unaffected, and a page priced for
// three wilayas falls back for the other fifty-five.
//
// Deliberately NOT a copy of every wilaya per page. A product that ships at the
// standard rate everywhere except Tamanrasset should be one row, not 58 — and
// snapshotting all of them would freeze the company's prices at the moment the
// page was made, so a later change to the standard rate would silently miss it.
model LandingDeliveryPrice {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String
  wilayaId      Int

  homePrice Decimal
  deskPrice Decimal?

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  wilaya      Wilaya      @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade on the page, so deleting a product takes its overrides with it —
  // an orphaned price row would be invisible and would apply to nothing.
  //
  // LEADS WITH tenantId, which `constraints.test.ts` enforces on every
  // tenant-scoped model. It is redundant here in the strict sense — a
  // landingPageId already belongs to exactly one tenant, so (landingPageId,
  // wilayaId) is transitively per-tenant — and that is precisely why the rule
  // is mechanical rather than case-by-case: "this one is safe because of a
  // relation somewhere else" is an argument that has to be re-made correctly
  // every time somebody adds a constraint, and it only has to be got wrong
  // once. The index is no weaker for carrying the column.
  @@unique([tenantId, landingPageId, wilayaId])
  @@index([tenantId])
  @@index([tenantId, landingPageId])
}

// -----------------------------------------------------------------------------

// The builder's Order, renamed. It is the IMMUTABLE commercial event: what the
// customer bought, at what price, to which address, frozen at submission.
// Every field is a snapshot and prices are never recalculated.
//
// The ERP's operational record is a separate model (FulfillmentOrder). Merging
// the two would put one table under two lifecycles. Naming them apart is all
// that happens here — the relationship between them, and replacing the webhook
// with an in-process domain event, is Phase 5.4 (M-05).
model SalesOrder {
  id            String @id @default(cuid())
  tenantId      String
  landingPageId String

  customerName String
  phone        String
  wilaya       String // snapshot of the wilaya name
  baladia      String // snapshot of the baladia name
  address      String
  notes        String?
  quantity     Int

  // Snapshot of the selected options: [{"name":"Color","value":"Black"}].
  // Json rather than an encoded string now that the database supports it.
  variants Json @default("[]")

  productPrice   Decimal // unit price including variant extras
  shippingPrice  Decimal // for the selected wilaya
  totalPrice     Decimal // (productPrice * quantity) + shippingPrice
  shippingMethod ShippingMethod   @default(HOME)
  status         SalesOrderStatus @default(NEW)

  /* AN.1 — where this order's visit came from, snapshotted at checkout with
   * the same derivation StorefrontVisit uses. Nullable: console-created,
   * imported and webhook orders have no browser session to derive from, and
   * null reads as "unattributed", never as a guessed channel. Kept ON the
   * order so "sales by source" survives any future pruning of raw visits. */
  sourceChannel String?
  sourceDetail  String?

  landingPage   LandingPage              @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  statusHistory SalesOrderStatusHistory[]

  // The ERP's operational record, when the tenant has the ERP (M-05).
  // Optional in both directions: a sale can exist without fulfilment tracking,
  // and a fulfilment order usually exists without a sale behind it.
  fulfillment FulfillmentOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, landingPageId])
  @@index([tenantId, phone])
}

// Timestamped record of every status transition, including the initial NEW
// (recorded with fromStatus = null).
model SalesOrderStatusHistory {
  id       String @id @default(cuid())
  tenantId String
  orderId  String

  fromStatus SalesOrderStatus?
  toStatus   SalesOrderStatus

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, orderId])
}

// A visitor who started the order form but never submitted it. Captured
// progressively as they type, so a phone number is recovered even if they
// leave. Created by the CUSTOMER, not by staff.
model DraftOrder {
  id       String @id @default(cuid())
  tenantId String
  // Random id the storefront generates per visit and keeps in sessionStorage,
  // so repeated updates from one visitor update one row instead of creating
  // hundreds. Sent from an UNAUTHENTICATED endpoint and used as the upsert key
  // before any session exists, so it must resolve without knowing the tenant —
  // which is why it stays globally unique. Random 128-bit values do not collide.
  token    String @unique

  landingPageId String

  customerName String?
  phone        String?
  wilaya       String?
  baladia      String?
  quantity     Int      @default(1)
  variants     Json     @default("[]")

  productPrice  Decimal?
  shippingPrice Decimal?
  totalPrice    Decimal?
  // Nullable, unlike SalesOrder: a draft is captured mid-typing and the
  // customer may not have chosen yet. Null means "not picked so far".
  shippingMethod ShippingMethod?

  // Set when the draft_order.created event was sent, so it fires exactly once
  // however many times the visitor edits the form.
  notifiedAt       DateTime?
  convertedOrderId String?
  convertedAt      DateTime?

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, landingPageId])
  @@index([tenantId, convertedOrderId])
}

/* =============================================================================
 * AN.1 — first-party page views with a derived traffic source.
 *
 * Until this table, the platform recorded NO first-party traffic at all: the
 * storefront's PageView reached third-party pixels only (and only when the
 * merchant had configured one), so "how many people saw this page" and "did
 * they come from Facebook or TikTok" were questions only Meta could answer,
 * about the merchant's own shop.
 *
 * One narrow row per page view, written by a client-side beacon (the
 * draft-capture pattern: silent, rate-limited, best-effort). Client-side on
 * purpose, twice over: most crawlers never execute the beacon, and a
 * server-render write would both stop working the day storefront pages become
 * cacheable (LB.14a.2) and count every cache MISS rather than every visitor.
 *
 * The source channel is DERIVED AT WRITE TIME (lib/storefront/traffic-source)
 * from utm_source / click ids / referrer, because the raw evidence is
 * ephemeral — the URL params are gone on the next navigation. `sourceDetail`
 * keeps the raw evidence string for debugging and future re-mapping.
 *
 * No FK-less orphan risk: deleteTenant() enumerates scoped models from the
 * DMMF (LB.27), so this table is swept without being named anywhere.
 *
 * RETENTION (AN.2, user-decided): raw rows live 30 DAYS, then delete —
 * `lib/storefront/visit-retention.ts` owns the constant and the prune, which
 * runs amortised on the beacon write, on every Traffic-screen read, and in
 * the worker tick's per-tenant housekeeping. The analytics windows (7/30d)
 * never exceed retention, so the screen never silently under-reports.
 * ========================================================================== */
model StorefrontVisit {
  id       String @id @default(cuid())
  tenantId String

  // Null for store-level pages (home, category); the page kind still says
  // WHAT was viewed so home traffic is not invisible.
  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  pageKind      String // "landing" | "home" | "category"

  // AN.2 — the LONG-LIVED visitor id (localStorage, random and meaningless),
  // so COUNT(DISTINCT) over a window is unique visitors, not unique
  // sessions. First-party, single-shop, no cross-site anything.
  visitorToken String
  // AN.2 — true when the visitor id existed BEFORE this session began,
  // decided client-side at session start (localStorage outlives the 30-day
  // raw-row retention, so "seen before" stays honest past the prune
  // horizon; a server lookup could only see retained rows).
  // Named isReturning, not "returning": RETURNING is a SQL keyword and the
  // uniques aggregate reads this column from raw SQL.
  isReturning Boolean @default(false)

  // Controlled vocabulary (facebook|tiktok|google|instagram|whatsapp|
  // telegram|direct|other) — validated at the route, so a console breakdown
  // can GROUP BY it without a normalisation pass.
  sourceChannel String
  // The raw evidence: utm_source as sent, or the referrer host. Bounded at
  // the contract; for labels and for re-deriving if the mapping grows.
  sourceDetail  String?

  /* ---------------------------------------------------------------------------
   * BH.1 — in-page behavior, flushed ONCE-per-view-lifecycle onto the SAME
   * row (no events table: volume does not multiply, the 30-day prune covers
   * behavior for free, and aggregation is column arithmetic). All nullable:
   * NULL means "not measured" — the page had not opted in, the view was not
   * a landing page, or the browser killed the page before the flush — and
   * must never be read as zero. Only rows with a non-null activeMs are
   * "measured" (the collector always sends it when armed).
   * ------------------------------------------------------------------------- */

  // Client-generated per-view id, the DraftOrder.token pattern: how an
  // unauthenticated exit beacon addresses the row its arrival beacon made.
  // Globally unique; nullable so pre-BH rows and store-level views need none.
  viewId String? @unique

  // The deepest landmark meaningfully entered: hero|description|reviews|faq|footer.
  furthestSection String?
  // The buy button became visible — the funnel's hinge.
  sawForm Boolean?

  galleryChanges      Int?
  galleryDeepestIndex Int?
  faqOpens            Int?
  // WHICH questions were opened (bounded ≤20): customer doubts, by id.
  faqOpenedIds   Json?
  variantChanges Int?

  stickyBuyClicked Boolean?
  // NOT a conversion (user-decided) — its own signal, surfaced as its own
  // column, because the order that follows a WhatsApp chat never touches
  // the checkout and must not be double-guessed into the funnel.
  whatsappClicked Boolean?

  // Visibility-gated time on page, ms. The "measured" marker (see above).
  activeMs Int?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, landingPageId, createdAt])
}

model Category {
  id       String @id @default(cuid())
  tenantId String

  name        String
  slug        String
  description String?
  icon        String?
  coverImage  String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  landingPages LandingPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, isVisible])
  @@index([tenantId, sortOrder])
}

// A storefront theme. Under decision D3 this is the customer-facing design
// system, which is deliberately NOT the console's: a tenant restyling their
// storefront must be incapable of affecting the admin UI.
//
// `isBuiltIn` rows are platform-provided starting points, copied into a tenant
// rather than shared, so editing one can never alter another tenant's pages.
// Turning this into a registry of real template LAYOUTS — not just colour sets
// — is M-19, in Phase 4.5.
model LandingTheme {
  id       String @id @default(cuid())
  tenantId String

  name              String
  primary           String
  primaryForeground String
  accent            String
  background        String
  card              String
  text              String
  muted             String
  border            String
  isBuiltIn         Boolean @default(false)
  sortOrder         Int     @default(0)

  landingPages LandingPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, sortOrder])
}

// One tracking destination — a Meta pixel, a TikTok pixel, a GA4 property, a
// GTM container, or a Google Ads conversion account (LB.5).
//
// GENERIC BY DESIGN: the mission's rule is that adding a provider must not
// mean redesigning the platform. A row declares WHICH provider interprets it;
// the provider adapters in `lib/tracking/providers/` decide what `publicId`
// and `serverToken` mean for that provider. Nothing else in the platform
// enumerates providers.
//
//   provider     'meta' | 'tiktok' | 'ga4' | 'gtm' | 'google-ads'
//   publicId     the browser-visible id: pixel id, measurement id (G-…),
//                container id (GTM-…), conversion id (AW-…)
//   serverToken  encrypted at rest; the server-side API credential — Meta CAPI
//                access token, TikTok Events API token, GA4 api_secret. Null
//                for providers with no server side (gtm, google-ads).
//   testCode     Meta test_event_code / TikTok test_event_code, so events can
//                be verified in the platform's Event Manager before going live.
//   settings     provider extras that are not secrets — e.g. the Google Ads
//                conversion label.
//   managedBy    'customer' (their own pixel) or 'platform' (a pixel this
//                deployment's operator manages for them). Both fire the same
//                way; the flag is what lets a platform operator find and
//                rotate THEIR pixels without touching customer-owned ones —
//                the mission's platform-managed/customer-owned split, carried
//                as data instead of as two code paths.
model TrackingIntegration {
  id       String @id @default(cuid())
  tenantId String

  provider    String
  label       String
  publicId    String
  serverToken String? // encrypted at rest
  testCode    String?
  settings    Json    @default("{}")
  managedBy   String  @default("customer")
  isActive    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, provider, isActive])
}

// Meta Pixel + Conversions API connection. Several can be active at once and
// each active row receives a copy of every server-side event. `accessToken` is
// stored encrypted and never returned in full once saved.
//
// LEGACY since LB.5: superseded by TrackingIntegration(provider: 'meta'),
// which the tracking pipeline reads exclusively. Kept only so existing rows
// remain visible in the console with a note to recreate them; remove the
// model once no deployment holds rows.
model MetaPixelConfig {
  id       String @id @default(cuid())
  tenantId String

  label       String
  pixelId     String
  accessToken String // encrypted at rest
  isActive    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
}

// Was StoreSettings with a literal id of "singleton" — one row for the one
// store that used to exist. Now one row per tenant.
model StoreSettings {
  tenantId String @id

  storeName        String  @default("LandingOS")
  storeDescription String?
  logo             String?
  favicon          String?
  phone            String?
  email            String?
  address          String?

  facebook  String?
  instagram String?
  tiktok    String?
  whatsapp  String?
  telegram  String?

  // Browser-side pixel, deliberately independent of MetaPixelConfig (which is
  // server-side CAPI only): the storefront pixel keeps firing even if every
  // CAPI config is disabled. The two systems must never depend on each other.
  metaBrowserPixelId String?

  updatedAt DateTime @updatedAt
}

// An outgoing webhook receiver. Under the platform this stops being internal
// plumbing between the two products and becomes a tenant-facing integration
// feature — the thing customers use to push their own events to their own
// tools. `secret` is encrypted and signs every payload with HMAC-SHA256.
model WebhookEndpoint {
  id       String @id @default(cuid())
  tenantId String

  label    String
  url      String
  secret   String  // encrypted at rest
  // Subscribed event names, e.g. ["order.created","order.updated"].
  events   Json    @default("[]")
  isActive Boolean @default(false)

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
}

// Delivery attempt log. Gives the tenant visibility into whether their receiver
// actually got each event, without storing the payload — which contains
// customer PII and would bloat the database.
model WebhookDelivery {
  id         String @id @default(cuid())
  tenantId   String
  endpointId String

  event      String
  resourceId String
  success    Boolean
  statusCode Int?
  attempts   Int     @default(1)
  error      String?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, endpointId, createdAt])
  @@index([tenantId, createdAt])
}
