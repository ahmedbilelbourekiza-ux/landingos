// LandingOS — unified schema.
//
// One database for the whole platform. Split across files by domain because a
// single file holding platform, builder and ERP models would be several
// thousand lines nobody reads twice:
//
//   main.prisma      generator + datasource
//   platform.prisma  tenancy, identity, access, billing, audit  (M-01)
//   builder.prisma   the website-builder's domain
//   erp.prisma       the ERP's domain, ported from SQLite       (M-06)
//
// CONVENTIONS, applied without exception in the domain files:
//
//   tenantId       Every business row carries it, and every compound index
//                  leads with it (M-03). The only models without one are the
//                  platform-owned reference tables, which are shared by design
//                  and say so where they are defined.
//
//   Money          Decimal, never Float. The ERP stored every monetary column
//                  as SQLite REAL — binary floating point — through FIFO cost
//                  lots, prorated expenses and margin calculations that feed
//                  permanent financial records. Float money drifts, and in that
//                  chain it drifts and compounds.
//
//   Time           DateTime, never epoch-millisecond integers. The ERP used
//                  INTEGER throughout; the conversion happens once, here,
//                  rather than living forever in every query.
//
//   Booleans       Boolean, never 0/1 integers.
//
//   Structured     Json (jsonb), never JSON-encoded TEXT.
//
//   Uniqueness     Every unique constraint has a recorded decision in
//                  ../../CONSTRAINTS.md, and test/constraints.test.ts asserts
//                  the schema matches it (M-04).
//
// Nothing here is wired to either application yet. Phase 3.2 is the schema and
// its guarantees; adopting it is 3.3 and later.

generator client {
  provider = "prisma-client-js"
  // Generated into this package rather than the hoisted node_modules/@prisma/client.
  //
  // The workspace now contains TWO Prisma schemas — this one and the
  // website-builder's — and both default to the same hoisted output. Whichever
  // ran last would silently overwrite the other's client, so the builder would
  // start failing with "model does not exist" for models that are right there
  // in its own schema. An explicit output makes the two coexist.
  output          = "../client"
  // relationJoins (LB.51): lets a query OPT IN to `relationLoadStrategy:
  // "join"`, collapsing an include's one-query-per-relation fan-out into one
  // SQL statement with lateral joins. On the pinned withTenant transaction
  // the query COUNT is the latency (D-PM.1.3), so the storefront page's
  // 7-relation include is the difference between ~10 serialized round trips
  // and ~3. The flag only ADDS the parameter — every query that does not
  // pass it keeps the default per-relation strategy, so the blast radius is
  // exactly the call sites that name it. Preview feature on Prisma 6.19,
  // measured against the statement census before adoption.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Runtime, as landingos_app: NOBYPASSRLS and owner of nothing, so row-level
  // security genuinely constrains it. Everything the application does goes
  // through this connection.
  url      = env("DATABASE_URL")
  // DDL, as neondb_owner, on Neon's direct (non-pooled) endpoint. Prisma
  // Migrate and `db push` use directUrl when it is set.
  //
  // The split is the whole point of the two-role model: the app role
  // deliberately cannot create, alter or drop a table, so migrations must
  // arrive on a different connection. Without this, `db push` runs as the app
  // role and fails with "must be owner of table" — which is the design
  // working, not a misconfiguration.
  directUrl = env("MIGRATE_DATABASE_URL")
}
